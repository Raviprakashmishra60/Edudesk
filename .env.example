# Copy this file to ".env" and fill in your own values.  NEVER commit ".env".

# Used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Leave empty to use the local SQLite file (edudesk.db).
# PostgreSQL example: postgresql://user:password@localhost:5432/edudesk
DATABASE_URL=

# WhatsApp number used by the "Need Help?" buttons (country code + number, no + or spaces)
WHATSAPP_NUMBER=918604551960

# Set to 1 when you deploy behind HTTPS so the login cookie is HTTPS-only
SESSION_COOKIE_SECURE=0

# Assistant backend: "rules" (built in). See assistant.py to plug in an AI API later.
ASSISTANT_PROVIDER=rules
# AI_API_KEY=   <- only needed after you add an AI provider (keep it in .env, never in code)

# 1 = debug mode for local development only
FLASK_DEBUG=1
